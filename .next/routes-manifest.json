    },
    {
      "page": "/dashboard/matching-analytics",
      "regex": "^/dashboard/matching\\-analytics(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/matching\\-analytics(?:/)?$"
    },
    {
      "page": "/dashboard/moderation",
      "regex": "^/dashboard/moderation(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/moderation(?:/)?$"
    },
    {
      "page": "/dashboard/questionnaire-stats",
      "regex": "^/dashboard/questionnaire\\-stats(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/questionnaire\\-stats(?:/)?$"
    },
    {
      "page": "/dashboard/scoring",
      "regex": "^/dashboard/scoring(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/scoring(?:/)?$"
    },
    {
      "page": "/dashboard/sent-pairs",
      "regex": "^/dashboard/sent\\-pairs(?:/)?$",
