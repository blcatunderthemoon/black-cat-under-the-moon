# ── Supabase（本地開發必填）────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# 伺服器端 Admin 操作（profile、配對、審核）— 切勿提交至 git
# 正式站必填（見 docs/SECURITY-REVIEW.md）
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── 網站 ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.blackcatunderthemoon.com
# Google Search Console HTML tag verification（選填）
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code

# ── PostHog 分析（選填；未設定 NEXT_PUBLIC_POSTHOG_KEY 則關閉）────────────────
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_ENABLED=1

# ── PayPal Moonlight Passport（選填；未設定則 /premium 頁僅支援人手付款）────
# 詳見 docs/paypal-onboarding.md
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Subscriptions → Plans → 月費方案 ID（P- 或 plan id）
PAYPAL_PLAN_ID=
# Developer Dashboard → Webhooks → Webhook ID（正式站必填）
PAYPAL_WEBHOOK_ID=
# sandbox | live — 正式站請設 live（詳見 docs/paypal-onboarding.md）
PAYPAL_MODE=live
# 選填；預設 https://www.paypal.com/myaccount/autopay/
# PAYPAL_MANAGE_URL=

# ── 人手付款 QR（PayMe 預設使用 public/PayCode.jpg）────────────────
# NEXT_PUBLIC_PAYME_QR_URL=/PayCode.jpg
# NEXT_PUBLIC_PAYME_LINK=
# 若需公開 FPS ID 才填；否則網站會引導用戶先電郵聯絡
# NEXT_PUBLIC_MANUAL_FPS_ID=

# ── Upstash Redis 速率限制（正式站必填；未設定則 API 回 503）────────
# 亦用於登入密碼鎖定（15 分鐘內錯密 10 次 → 凍結 30 分鐘；見 docs/AUTH-LOGIN-LOCKOUT.md）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudinary 討論區圖片（選填）────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=forum_unsigned
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Cloudflare Turnstile（正式站必填 CF_TURNSTILE_SECRET）────────
# Cloudflare 後台 Widget 建議用 Managed / Non-interactive（較少誤判真人）
# 換 domain 時須在 Turnstile 加入新 hostname，並確認 site key / secret 配對
CF_TURNSTILE_SECRET=
NEXT_PUBLIC_CF_TURNSTILE_SITE_KEY=
# 僅在 edge IP 與 Cloudflare 一致時設 true；預設關閉，避免 Vercel 代理誤判
# CF_TURNSTILE_BIND_IP=true

# ── Gmail 郵件通知（選填）──────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
# 預設 465（SSL）。若網路封鎖 587 請保持 465；僅在環境允許時改 587
GMAIL_SMTP_PORT=465
# 本地測試：設後所有配對通知改寄到此信箱（不寫入 sent_matches 仍會照常）
# MATCH_TEST_EMAIL=lhuen2010@gmail.com

# ── 管理員 API（正式站必填；本地未設定則不驗證 x-dashboard-key）──
# Dashboard admin API key (header: x-dashboard-key). Alias: DASHBOARD_PASSWORD
DASHBOARD_SECRET=

# ── Vercel Cron（論壇 Hit Topic → forum_banner）──
# Vercel 會以 Authorization: Bearer <CRON_SECRET> 呼叫 /api/cron/*
# 題庫／開關／每日則數：優先用 Dashboard → Hit Topics（forum_hit_topics 表）
CRON_SECRET=
# FORUM_HIT_TOPIC_CRON_ENABLED=0
# FORUM_HIT_TOPIC_CRON_FORCE_ACTIVE=0
# FORUM_HIT_TOPIC_DAILY_COUNT=3
