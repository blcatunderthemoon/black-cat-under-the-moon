{
  "name": "black-cat-quiz",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "node scripts/clean-next-cache.mjs && next dev -p 3000",
    "build:mirror-v3": "node scripts/build-mirror-v3-browser.js && node scripts/build-mirror-narratives-browser.js && node scripts/vendor-mirror-capture.js",
    "build": "node scripts/build-mirror-v3-browser.js && node scripts/build-mirror-narratives-browser.js && node scripts/vendor-mirror-capture.js && next build",
    "start": "next start",
    "dashboard": "next dev -p 3000",
    "website": "vercel dev",
    "seed": "node scripts/seed-test-data.mjs",
    "seed:clear": "node scripts/seed-test-data.mjs --clear",
    "test:match": "node scripts/test-matching.mjs",
    "test:email-automation-filters": "node scripts/test-email-automation-filters.mjs",
    "test:cards": "node scripts/test-matching.mjs --generateCards",
    "generate:card": "node scripts/generate-matches.mjs",
    "export:excel": "node scripts/export-matches.mjs",
    "backup:supabase": "node scripts/backup-supabase-tables.mjs",
    "backup:supabase:install-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-daily-backup-task.ps1",
    "backup:supabase:uninstall-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-daily-backup-task.ps1",
    "restore:supabase": "node scripts/restore-supabase-from-backup.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@tiptap/extension-character-count": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-youtube": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "exceljs": "^3.4.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "imapflow": "^1.3.3",
    "jszip": "^3.10.1",
    "next": "^15.3.9",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "tiptap-markdown": "^0.9.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
